                    "nullable": true
                  },
                  "card_holder_name": {
                    "type": "string",
                    "description": "Card holder name.",
                    "nullable": true
                  },
                  "card_issuer_country": {
                    "type": "string",
                    "description": "Issuer country code.",
                    "nullable": true
                  },
                  "card_issuer_bank": {
                    "type": "string",
                    "description": "Issuing bank.",
                    "nullable": true
                  }
                }
              },
              {
                "title": "Net banking",
                "type": "object",
                "properties": {
                  "bank_ref_num": {
                    "type": "string",
