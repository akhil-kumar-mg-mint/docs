{
  "openapi": "3.0.3",
  "info": {
    "title": "EximPe Payment Gateway API — v3 Payments",
    "version": "3.0.0",
    "description": "List and retrieve payments on the v3 API. v1 and v2 use the same paths and return the same response; this spec carries the v3 reference."
  },
  "servers": [
    {
      "url": "https://api-pacb-uat.eximpe.com",
      "description": "Payment Gateway Sandbox URL"
    }
  ],
  "tags": [
    {
      "name": "Payments"
    }
  ],
  "paths": {
    "/pg/payments/": {
      "get": {
        "summary": "List Payments",
        "description": "Return a paginated list of payments, newest first, with optional filters.",
        "operationId": "v3_listPayments",
        "tags": [
          "Payments"
        ],
        "security": [
          {
            "clientAuth": [],
            "clientSecretAuth": [],
            "apiVersionHeader": []
          },
          {
            "clientAuth": [],
            "clientSecretAuth": [],
            "merchantAuth": [],
            "apiVersionHeader": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, starting at 1. Stop when `next` is null: a page past the last one is refused with a 500.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "description": "Payments per page. Values above 1000 are capped at 1000.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 250
            }
          },
          {
            "name": "ordering",
            "in": "query",
            "required": false,
            "description": "Sort order. Prefix with `-` for descending. An unrecognised value is ignored.",
            "schema": {
              "type": "string",
              "enum": [
                "-created_at",
                "created_at",
                "-last_updated_at",
                "last_updated_at",
                "-payment_completed_at",
                "payment_completed_at"
              ],
              "default": "-created_at"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Case-insensitive substring match across payment ID, order ID, reference ID, invoice number, buyer name, buyer email and bank reference.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "payment_id",
            "in": "query",
            "required": false,
            "description": "Exact payment ID.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "order_id",
            "in": "query",
            "required": false,
            "description": "Exact order ID.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "reference_id",
            "in": "query",
            "required": false,
            "description": "Exact reference ID (case-sensitive).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "invoice_number",
            "in": "query",
            "required": false,
            "description": "Exact invoice number (case-sensitive).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "buyer_name",
            "in": "query",
            "required": false,
            "description": "Exact buyer name (case-sensitive). Use `search` for a partial match.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "merchant",
            "in": "query",
            "required": false,
            "description": "Merchant ID. PSPs can use it to narrow the list to one sub-merchant.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "description": "ISO 4217 currency code, e.g. `INR`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mop_type",
            "in": "query",
            "required": false,
            "description": "Method of payment. Case-insensitive; comma-separate several values.",
            "schema": {
              "type": "string",
              "example": "upi,credit_card"
            }
          },
          {
            "name": "collection_mode",
            "in": "query",
            "required": false,
            "description": "`hosted_payment`, `payment_link` or `s2s`. Case-insensitive; comma-separate several values.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "`pending`, `captured` or `failed`. Case-insensitive; comma-separate several values. Matches the status as recorded — see the note on expired payments.",
            "schema": {
              "type": "string",
              "example": "captured"
            }
          },
          {
            "name": "from_created_at",
            "in": "query",
            "required": false,
            "description": "Created on or after this date (`YYYY-MM-DD`, UTC).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to_created_at",
            "in": "query",
            "required": false,
            "description": "Created on or before this date (`YYYY-MM-DD`, UTC). The whole day is included.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "from_payment_completed_at",
            "in": "query",
            "required": false,
            "description": "Completed on or after this date (`YYYY-MM-DD`, UTC).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to_payment_completed_at",
            "in": "query",
            "required": false,
            "description": "Completed on or before this date (`YYYY-MM-DD`, UTC). The whole day is included.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of payments",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/v3_ListPaymentsResponse"
                },
                "examples": {
                  "One page": {
                    "summary": "One page",
                    "value": {
                      "success": true,
                      "message": "Domestic payment requests retrieved successfully",
                      "data": {
                        "count": 2,
                        "page": 1,
                        "page_size": 250,
                        "next": null,
                        "previous": null,
                        "results": [
                          {
                            "payment_id": "PR4350279153",
                            "merchant": {
                              "id": "4417290356",
                              "name": "Acme Exports"
                            },
                            "reference_id": "ORD-2026-000123",
                            "buyer": {
                              "name": "Rahul Sharma",
                              "email": "rahul.sharma@example.com",
                              "phone": "+919876543210"
                            },
                            "order_id": "OD8196969047",
                            "invoice_number": "INV2026000123",
                            "amount": {
                              "amount": "1500",
                              "total_amount": "1500",
                              "currency": "INR"
                            },
                            "created_at": "2026-10-15T06:44:13.414209Z",
                            "comment": null,
                            "mop_type": "upi",
                            "status": "captured"
                          },
                          {
                            "payment_id": "PR1352481140",
                            "merchant": {
                              "id": "4417290356",
                              "name": "Acme Exports"
                            },
                            "reference_id": "ORD-2026-000118",
                            "buyer": {
                              "name": "Priya Nair",
                              "email": "priya.nair@example.com",
                              "phone": "+919812345678"
                            },
                            "order_id": "OD3094308378",
                            "invoice_number": "INV2026000118",
                            "amount": {
                              "amount": "2499.5",
                              "total_amount": "2499.5",
                              "currency": "INR"
                            },
                            "created_at": "2026-10-14T08:22:59.613699Z",
                            "comment": "Payment abandoned by user",
                            "mop_type": "credit_card",
                            "status": "failed"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/v3_ErrorResponse"
                },
                "examples": {
                  "Missing credentials": {
                    "summary": "Missing credentials",
                    "value": {
                      "success": false,
                      "error": {
                        "code": "ERR_AUTH_000",
                        "message": "Missing credentials",
                        "details": {
                          "authentication": "Missing credentials."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Invalid filter value, invalid date or a page past the last one",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/v3_ErrorResponse"
                },
                "examples": {
                  "Invalid status": {
                    "summary": "Invalid status",
                    "value": {
                      "success": false,
                      "error": {
                        "code": 40350,
                        "message": "Failed to retrieve domestic payment requests",
                        "details": {
                          "error": "{'status': ErrorDetail(string='Invalid value. Must be one of: PENDING, CAPTURED, FAILED, INVALID', code='invalid')}"
                        }
                      }
                    }
                  },
                  "Page past the last one": {
                    "summary": "Page past the last one",
                    "value": {
                      "success": false,
                      "error": {
                        "code": 40350,
                        "message": "Failed to retrieve domestic payment requests",
                        "details": {
                          "error": "Invalid page."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/pg/payments/{payment_id}/": {
      "get": {
        "summary": "Get Payment",
        "description": "Return one payment with its order, settlement, refunds and method-of-payment details.",
        "operationId": "v3_getPayment",
        "tags": [
          "Payments"
        ],
        "security": [
          {
            "clientAuth": [],
            "clientSecretAuth": [],
            "apiVersionHeader": []
          },
          {
            "clientAuth": [],
            "clientSecretAuth": [],
            "merchantAuth": [],
            "apiVersionHeader": []
          }
        ],
        "parameters": [
          {
            "name": "payment_id",
            "in": "path",
            "required": true,
            "description": "Payment ID, e.g. `PR4350279153`.",
            "schema": {
              "type": "string"
            }
          }
        ],
