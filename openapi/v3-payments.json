              "pending",
              "captured",
              "failed"
            ]
          },
          "status_message": {
            "type": "string",
            "description": "Payment status message.",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the payment was created, UTC with microseconds."
          }
        }
      },
      "v3_GetPaymentResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/v3_Payment"
          }
        }
      }
    }
  }
