{
  "openapi": "3.0.0",
  "info": {
    "title": "EximPe Payment Gateway API \u2014 v3 Orders",
    "description": "Create Order for the v3 API. v3 supports two collection modes: Hosted Checkout and S2S UPI Intent.",
    "version": "3.0.0"
  },
  "servers": [
    {
      "url": "https://api-pacb-uat.eximpe.com",
      "description": "Payment Gateway Sandbox URL"
    }
  ],
  "paths": {
    "/pg/orders/": {
      "post": {
        "summary": "Create Order",
        "operationId": "v3_createOrder",
        "tags": [
          "Orders"
        ],
        "security": [
          {
            "clientAuth": [],
            "clientSecretAuth": []
          },
          {
            "clientAuth": [],
            "clientSecretAuth": [],
            "merchantAuth": []
          }
        ],
        "requestBody": {
          "description": "Order creation request",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/v3_CreateOrderRequest"
              },
              "examples": {
                "Hosted Checkout": {
                  "summary": "Hosted Checkout",
                  "description": "Buyer completes payment on the EximPe-hosted page.",
                  "value": {
                    "amount": "1000.00",
                    "currency": "INR",
                    "reference_id": "ORDER-123456",
                    "collection_mode": "hosted_payment",
                    "mop_type": "upi",
                    "return_url": "https://yourdomain.com/payment/callback/",
                    "business_model": "B2C",
                    "buyer": {
                      "name": "Alice Smith",
                      "email": "alice.smith@example.com",
                      "phone": "+919812345678",
                      "address": {
                        "line_1": "221B Baker Street",
                        "city": "Mumbai",
                        "state": "Maharashtra",
                        "postal_code": "400001"
                      }
                    },
                    "product": {
                      "name": "Wireless Headphones",
                      "description": "Premium noise-cancelling wireless headphones",
                      "hs_code": "85183000",
                      "hs_code_description": "Headphones and earphones, whether or not combined with a microphone",
                      "type_of_goods": "physical_goods"
                    },
                    "invoice": {
                      "number": "INV-2026-0001",
                      "date": "2026-09-21"
                    }
                  }
                },
                "S2S UPI Intent": {
                  "summary": "S2S UPI Intent",
                  "description": "Server-to-server UPI intent flow.",
                  "value": {
                    "amount": "1000.00",
                    "currency": "INR",
                    "reference_id": "ORDER-123457",
                    "collection_mode": "s2s",
                    "mop_type": "upi",
                    "upi_flow_type": "intent",
                    "return_url": "https://yourdomain.com/payment/callback/",
                    "buyer": {
                      "name": "John Doe",
                      "email": "john.doe@example.com",
                      "phone": "+919876543210",
                      "address": {
                        "line_1": "123 Main Street",
                        "city": "Delhi",
                        "state": "Delhi",
                        "postal_code": "110001"
                      },
                      "ip_address": "192.168.1.100",
                      "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
                    },
                    "product": {
                      "name": "Smartphone",
                      "description": "This is a sample product description",
                      "hs_code": "85171290",
                      "hs_code_description": "Telephones for cellular networks, other than smartphones",
                      "type_of_goods": "physical_goods"
                    },
                    "invoice": {
                      "number": "INV-2026-0002",
                      "date": "2026-09-21"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/v3_CreateOrderResponse"
                },
                "examples": {
                  "Hosted Checkout": {
                    "summary": "Hosted Checkout",
                    "value": {
                      "success": true,
                      "message": "Checkout session created successfully",
                      "data": {
                        "session_id": "b4db5e1c82db8636094f54e3293218172ae2ab87dee6ce4e97c82db6c63f243a",
                        "order_id": "OD5916184980"
                      }
                    }
                  },
                  "S2S UPI Intent": {
                    "summary": "S2S UPI Intent",
                    "value": {
                      "success": true,
                      "message": "S2S UPI Request created successfully",
                      "data": {
                        "intent_uri": "pa=collect.sandbox@examplebank&pn=&tr=403993715534292371&tid=TXN403993715534292371080725205418&am=1000.00&cu=INR&tn=UPIIntent",
                        "order_id": "OD2000992103",
                        "expires_at": "2026-09-21T10:35:00Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The request was refused. Always `ERR_ORDER_002`; read `details`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/v3_ErrorResponse"
                },
                "examples": {
                  "Invalid fields": {
                    "summary": "Invalid fields",
                    "value": {
                      "success": false,
                      "error": {
                        "code": "ERR_ORDER_002",
                        "message": "Validation error",
                        "details": {
                          "buyer": {
                            "email": "Enter a valid email address.",
                            "phone": "Enter a valid phone number."
                          }
                        }
                      }
                    }
                  },
                  "Duplicate reference_id": {
                    "summary": "reference_id already used",
                    "value": {
                      "success": false,
                      "error": {
                        "code": "ERR_ORDER_002",
                        "message": "Validation error",
                        "details": {
                          "reference_id": "Reference ID already exists"
                        }
                      }
                    }
                  },
                  "Duplicate invoice number": {
                    "summary": "Invoice number already used",
                    "value": {
                      "success": false,
                      "error": {
                        "code": "ERR_ORDER_002",
                        "message": "Validation error",
                        "details": {
                          "invoice": {
                            "number": "Invoice Number already exists"
                          }
                        }
                      }
                    }
                  },
                  "Purpose code": {
                    "summary": "purpose_code not enabled",
                    "value": {
                      "success": false,
                      "error": {
                        "code": "ERR_ORDER_002",
                        "message": "Validation error",
                        "details": "Purpose code is not enabled for this merchant."
                      }
                    }
                  },
                  "Invalid collection mode": {
                    "summary": "collection_mode missing or unrecognised",
                    "value": {
                      "success": false,
                      "error": {
                        "code": "ERR_ORDER_002",
                        "message": "Validation error",
                        "details": {
                          "collection_mode": "Invalid collection mode"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong credentials, or a PSP left out X-Merchant-ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/v3_ErrorResponse"
                },
                "examples": {
                  "Missing credentials": {
                    "summary": "Missing credentials",
                    "value": {
                      "success": false,
                      "error": {
                        "code": "ERR_AUTH_000",
                        "message": "Missing credentials",
                        "details": {
                          "authentication": "Missing credentials."
                        }
                      }
                    }
                  },
                  "Invalid credentials": {
                    "summary": "Invalid credentials",
                    "value": {
                      "success": false,
                      "error": {
                        "code": "ERR_AUTH_001",
                        "message": "Invalid credentials",
                        "details": {
                          "authentication": "Invalid credentials."
                        }
                      }
                    }
                  },
                  "Missing X-Merchant-ID": {
                    "summary": "PSP without X-Merchant-ID",
                    "value": {
                      "success": false,
                      "error": {
                        "code": "ERR_AUTH_000",
                        "message": "Missing credentials",
                        "details": {
                          "authentication": "X-Merchant-ID header is required for this endpoint."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Your account cannot create this order \u2014 for example, S2S payments are not enabled on it",
            "content": {
              "application/json": {
                "examples": {
                  "S2S not enabled": {
                    "summary": "S2S not enabled",
                    "value": {
                      "detail": "You do not have permission to perform this action."
                    }
                  },
                  "Merchant inactive": {
                    "summary": "Merchant account inactive",
                    "value": {
                      "success": false,
                      "error": {
                        "code": "ERR_MERCHANT_ACCOUNT_002",
                        "message": "Merchant account is not active",
                        "details": {
                          "authentication": "Merchant account is inactive."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/v3_ErrorResponse"
                },
                "examples": {
                  "Unexpected": {
                    "summary": "Unexpected error",
                    "value": {
                      "success": false,
                      "error": {
                        "code": "ERR_SERVICE_ERROR_000",
                        "message": "Payment gateway error",
                        "details": {
                          "error": "An unexpected error occurred. Please try again later"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiVersion"
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "clientAuth": {
        "type": "apiKey",
        "name": "X-Client-ID",
        "in": "header",
        "description": "**Client Application ID** - Your unique application identifier used to authenticate API requests. You can find your Client ID in the Developer Settings section of the merchant dashboard.",
        "x-displayName": "Client ID",
        "x-example": "your-client-id"
      },
      "clientSecretAuth": {
        "type": "apiKey",
        "name": "X-Client-Secret",
        "in": "header",
        "description": "**Client Secret Key** - Your secret key used alongside the Client ID for secure authentication. Keep this confidential and never expose it in client-side code. Available in the Developer Settings section of the merchant dashboard.",
        "x-displayName": "Client Secret",
        "x-example": "your-client-secret"
      },
      "merchantAuth": {
        "type": "apiKey",
        "name": "X-Merchant-ID",
        "in": "header",
        "description": "**Sub-merchant ID** - Send this only when you authenticate as a PSP and create the order for one of your sub-merchants: it names that sub-merchant. A PSP that leaves it out is refused with a `401`. Merchants that authenticate with their own Client ID and Client Secret do not send it.",
        "x-displayName": "Merchant ID (PSPs only)",
        "x-example": "your-merchant-id"
      }
    },
    "schemas": {
      "v3_Address": {
        "type": "object",
        "required": [
          "postal_code"
        ],
        "properties": {
          "line_1": {
            "type": "string",
            "description": "Address line 1"
          },
          "line_2": {
            "type": "string",
            "description": "Address line 2"
          },
          "city": {
            "type": "string",
            "maxLength": 255,
            "description": "City"
          },
          "state": {
            "type": "string",
            "maxLength": 255,
            "description": "State"
          },
          "postal_code": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "description": "A valid 6-digit Indian PIN code",
            "example": "400001"
          }
        }
      },
      "v3_Buyer": {
        "type": "object",
        "required": [
          "name",
          "address",
          "email",
          "phone"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Buyer's full name",
            "maxLength": 255
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Buyer's email address"
          },
          "phone": {
            "type": "string",
            "description": "Phone number in E.164 format: `+`, the country code, then the number (e.g. `+919812345678`)",
            "pattern": "^\\+[1-9]\\d{1,14}$"
          },
          "address": {
            "$ref": "#/components/schemas/v3_Address"
          },
          "ip_address": {
            "type": "string",
            "description": "The customer's IP address. Required for S2S UPI Intent; ignored for Hosted Checkout"
          },
          "user_agent": {
            "type": "string",
            "description": "The customer's browser user agent. Required for S2S UPI Intent; ignored for Hosted Checkout"
          }
        }
      },
      "v3_CreateOrderRequest": {
        "type": "object",
        "required": [
          "amount",
          "currency",
          "reference_id",
          "collection_mode",
          "buyer",
          "product",
          "invoice"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "example": "1000.00",
            "description": "Amount in rupees, as a decimal string such as `\"1000.00\"`. A JSON number is also accepted. More than two decimal places are rounded to two, so `1000.456` is charged as `1000.46`. Must be greater than 0 and at most 10,000,000.00."
          },
          "currency": {
            "type": "string",
            "enum": [
              "INR"
            ],
            "description": "ISO 4217 currency code. Hosted Checkout and S2S UPI Intent collect in INR only."
          },
          "reference_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^[A-Za-z0-9-]+$",
            "example": "ORDER-123456",
            "description": "Your reference for the order: letters, numbers and hyphens only. Must be unique across your orders, including failed ones."
          },
          "return_url": {
            "type": "string",
            "format": "uri",
            "maxLength": 500,
            "description": "Optional. Where Hosted Checkout sends the customer when the payment finishes. Without it the customer sees EximPe's own result page. S2S UPI Intent does not redirect the customer."
          },
          "collection_mode": {
            "type": "string",
            "description": "Mode of payment collection. Required \u2014 there is no server-side default.",
            "enum": [
              "hosted_payment",
              "s2s"
            ]
          },
          "mop_type": {
            "type": "string",
            "description": "Hosted Checkout: optional, pre-selects a payment method on the payment page. S2S UPI Intent: must be `upi`.",
            "enum": [
              "credit_card",
              "debit_card",
              "upi",
              "net_banking",
              "qr"
            ]
          },
          "upi_flow_type": {
            "type": "string",
            "description": "Required for S2S UPI Intent, where it must be `intent`. Not used by Hosted Checkout.",
            "enum": [
              "intent"
            ]
          },
          "business_model": {
            "type": "string",
            "enum": [
              "B2B",
              "B2C"
            ],
            "description": "Whether the buyer is a business (B2B) or a consumer (B2C). Optional \u2014 derived from the merchant's KYC when omitted."
          },
          "purpose_code": {
            "type": "string",
            "description": "FEMA/FETERS purpose code this order settles under (e.g. S0802). Optional \u2014 derived from the merchant's allowed purpose codes when omitted and exactly one is allowed.",
            "example": "S0802"
          },
          "buyer": {
            "$ref": "#/components/schemas/v3_Buyer"
          },
          "product": {
            "$ref": "#/components/schemas/v3_Product"
          },
          "invoice": {
            "$ref": "#/components/schemas/v3_Invoice"
          }
        }
      },
      "v3_CreateOrderResponse": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Indicates if the request was successful"
          },
          "message": {
            "type": "string",
            "description": "Response message"
          },
          "data": {
            "$ref": "#/components/schemas/v3_OrderData"
          }
        }
      },
      "v3_ErrorDetails": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Error code (e.g., ERR_ORDER_002)"
          },
          "message": {
            "type": "string",
            "description": "Error message"
          },
          "details": {
            "description": "What failed. Usually an object keyed by field and nested like the request, one message per field. A purpose-code refusal is a plain string.",
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": true
              },
              {
                "type": "string"
              }
            ]
          }
        }
      },
      "v3_ErrorResponse": {
        "type": "object",
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ],
            "description": "Indicates if the request was successful. Always false for error responses."
          },
          "error": {
            "$ref": "#/components/schemas/v3_ErrorDetails"
          }
        }
      },
      "v3_Invoice": {
        "type": "object",
        "required": [
          "number"
        ],
        "properties": {
          "number": {
            "type": "string",
            "maxLength": 255,
            "example": "INV-2026-0001",
            "description": "Invoice number. Letters, numbers, spaces and `. , ' - / & _ ( ) : ; ! @ # $ % * + = < > [ ] { } | ~`. Must be unique across your orders that have not failed."
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Invoice date, `YYYY-MM-DD`"
          }
        }
      },
      "v3_OrderData": {
        "type": "object",
        "required": [
          "order_id"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Hosted Checkout only. 64-character hex string you pass to the EximPe JS SDK. Valid for 15 minutes."
          },
          "order_id": {
            "type": "string",
            "description": "Unique order identifier"
          },
          "intent_uri": {
            "type": "string",
            "description": "S2S UPI Intent only. The UPI payment request. It may or may not start with `upi://pay?` \u2014 see the Create Order page for how to invoke it."
          },
          "test_simulator_url": {
            "type": "string",
            "description": "Sandbox only. Open in a browser to complete an S2S UPI Intent payment without a real UPI app. Not returned in production."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "S2S UPI Intent only. When the intent stops accepting payment, in UTC \u2014 5 minutes after creation."
          }
        }
      },
      "v3_Product": {
        "type": "object",
        "required": [
          "name",
          "type_of_goods"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Product name"
          },
          "description": {
            "type": "string",
            "description": "Product description",
            "maxLength": 1024
          },
          "hs_code": {
            "type": "string",
            "description": "8-digit HS code. Required when `type_of_goods` is `physical_goods`"
          },
          "hs_code_description": {
            "type": "string",
            "description": "Description of the HS code"
          },
          "type_of_goods": {
            "type": "string",
            "description": "Nature of what is sold",
            "enum": [
              "physical_goods",
              "digital_goods",
              "service"
            ]
          }
        }
      }
    },
    "parameters": {
      "ApiVersion": {
        "name": "X-API-Version",
        "in": "header",
        "required": false,
        "description": "The API version you integrate against. Send `3.0.0` for v3. It is a version selector, not a credential.",
        "schema": {
          "type": "string",
          "enum": [
            "3.0.0"
          ],
          "default": "3.0.0"
        },
        "example": "3.0.0"
      }
    }
  }
}
