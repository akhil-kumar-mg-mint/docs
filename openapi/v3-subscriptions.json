{
  "openapi": "3.0.0",
  "info": {
    "title": "Eximpe Payment Gateway API - V3 Subscriptions",
    "description": "Subscription creation and mandate management on the v3 API. Every call carries X-API-Version: 3.0.0.",
    "license": {
      "name": "Proprietary"
    },
